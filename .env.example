# Скопіюйте у .env і заповніть ОДИН із блоків нижче.

# Провайдер: anthropic | foundry
LLM_PROVIDER=anthropic

# Модель. Для foundry — назва деплойменту (за замовчуванням збігається з ID моделі).
LLM_MODEL=claude-sonnet-5-5

# --- Anthropic API (https://platform.claude.com) ---
ANTHROPIC_API_KEY=

# --- Claude у Microsoft Foundry ---
# Ключ і назва ресурсу: Foundry portal → Build → Models → ваш деплоймент → Details
ANTHROPIC_FOUNDRY_API_KEY=
# Або назва ресурсу (https://{resource}.services.ai.azure.com/anthropic/) ...
ANTHROPIC_FOUNDRY_RESOURCE=
# ... або повний base URL. Задайте щось одне.
ANTHROPIC_FOUNDRY_BASE_URL=

# --- Застосунок ---
PORT=3000
BRAND_PATH=brand/socklock.md
LIBRARY_PATH=data/hooks_library.csv
RULES_PATH=config/claims-rules.json
